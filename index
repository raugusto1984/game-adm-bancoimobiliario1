// ===============================
// TABULEIRO
// ===============================

function posicaoCasa(i) {
  let col, row;
  let x = 25;
  let y = 75;
  let tamanho = 75;
  let espaco = 4;

  if (i <= 6) {
    col = i;
    row = 0;
  } else if (i <= 11) {
    col = 6;
    row = i - 6;
  } else if (i <= 18) {
    col = 18 - i;
    row = 6;
  } else {
    col = 0;
    row = 24 - i;
  }

  return {
    x: x + col * (tamanho + espaco),
    y: y + row * (tamanho + espaco),
    tamanho: tamanho
  };
}

function corCasa(tipo) {
  if (tipo === "inicio") return [70, 190, 120];
  if (tipo === "empresa") return [65, 110, 180];
  if (tipo === "imposto") return [210, 80, 80];
  if (tipo === "bonus") return [220, 170, 50];
  if (tipo === "investir") return [145, 90, 200];
  if (tipo === "evento") return [210, 120, 60];
  return [80, 95, 115];
}

function desenharTabuleiro() {
  for (let i = 0; i < casas.length; i++) {
    let p = posicaoCasa(i);
    let c = casas[i];

    fill(...corCasa(c.tipo));
    stroke(255, 100);
    strokeWeight(1);
    rect(p.x, p.y, p.tamanho, p.tamanho, 8);

    noStroke();
    fill(255);
    textSize(10);
    text(c.nome, p.x + 37, p.y + 17);

    if (c.tipo === "empresa") {
      textSize(10);
      text("R$" + c.preco, p.x + 37, p.y + 37);

      if (c.dono !== -1) {
        fill(...jogadores[c.dono].cor);
        circle(p.x + 37, p.y + 60, 15);
      }
    }

    if (c.tipo === "inicio") {
      textSize(10);
      text("SAÍDA", p.x + 37, p.y + 43);
    }

    // Peças dos jogadores
    for (let j = 0; j < jogadores.length; j++) {
      if (jogadores[j].posicao === i) {
        let coluna = j % 3;
        let linha = floor(j / 3);

        let px = p.x + 18 + coluna * 19;
        let py = p.y + 65 + linha * 12;

        fill(...jogadores[j].cor);
        stroke(255);
        strokeWeight(1);
        circle(px, py, 15);
        noStroke();
      }
    }
  }

  // Centro do tabuleiro
  fill(35, 48, 70);
  rect(110, 170, 335, 315, 15);

  fill(255);
  textSize(24);
  text("IMPÉRIO", 277, 225);
  text("EMPRESARIAL", 277, 260);

  fill(100, 220, 160);
  textSize(18);
  text("Construa seu negócio!", 277, 320);

  fill(220);
  textSize(15);
  text("Compre empresas", 277, 370);
  text("Invista e receba aluguéis", 277, 400);
  text("Acumule seu patrimônio", 277, 430);
}

