    let x = 575;
    let y = 85 + i * 75;

    fill(42, 55, 77);
    rect(x, y, 395, 65, 10);

    fill(...j.cor);
    circle(x + 25, y + 32, 20);

    fill(255);
    textAlign(LEFT, CENTER);
    textSize(14);
    text(j.nome, x + 48, y + 17);

    textSize(12);
    text("Caixa: R$ " + j.dinheiro.toLocaleString("pt-BR"),
         x + 48, y + 42);

    fill(180);
    textAlign(RIGHT, CENTER);
    text("Voltas: " + j.voltas + "/3", x + 375, y + 20);
    text("Patrimônio: R$ " +
      patrimonio(i).toLocaleString("pt-BR"),
      x + 375, y + 43);

    textAlign(CENTER, CENTER);
  }

  let atual = jogadores[jogadorAtual];

  fill(255);
  textSize(19);
  text("VEZ DE " + atual.nome.toUpperCase(), 775, 560);

  fill(...atual.cor);
  circle(775, 595, 25);

  fill(255);
  textSize(20);
  text("DADO: " + dado, 775, 630);

  if (!acaoPendente && !jogoFinalizado) {
    criarBotao("🎲 LANÇAR DADO",
      640, 660, 270, 65, jogarDado);
  }

  if (acaoPendente) {
    desenharAcao();
  }

  fill(200);
  textSize(12);
  text("Cada jogador completa 3 voltas.",
       775, 735);
}

// ===============================
// DADOS E MOVIMENTAÇÃO
// ===============================

function jogarDado() {
  if (acaoPendente || jogoFinalizado) return;

  let j = jogadores[jogadorAtual];

  dado = floor(random(1, 7));

  let antiga = j.posicao;
  let nova = antiga + dado;

  if (nova >= 24) {
    j.voltas++;
    j.dinheiro += 1000;
    mensagem = j.nome + " passou pelo início e recebeu R$ 1.000!";
  }

  j.posicao = nova % 24;

  resolverCasa();
}

function resolverCasa() {
  let j = jogadores[jogadorAtual];
  let c = casas[j.posicao];

  if (c.tipo === "inicio") {
    mensagem = "Você chegou ao início!";
    proximoJogador();
    return;
  }

  if (c.tipo === "empresa") {
    if (c.dono === -1) {
      mensagem = "Empresa disponível para compra!";
      acaoPendente = "empresa";
      return;
    }

    if (c.dono === jogadorAtual) {
      mensagem = "Esta empresa já pertence a você!";
      proximoJogador();
      return;
    }

    let aluguel = c.aluguel;
    let dono = jogadores[c.dono];

    let pagamento = min(j.dinheiro, aluguel);
    j.dinheiro -= pagamento;
    dono.dinheiro += pagamento;

    mensagem = j.nome + " pagou R$ " + pagamento +
      " de aluguel para " + dono.nome + ".";

    proximoJogador();
    return;
  }

  if (c.tipo === "imposto") {
    let imposto = 1000;
    j.dinheiro -= imposto;
    mensagem = "Você pagou R$ 1.000 de impostos!";
    proximoJogador();
    return;
  }

  if (c.tipo === "bonus") {
    let premio = floor(random(500, 2001));
    j.dinheiro += premio;
    mensagem = "Parabéns! Você recebeu R$ " + premio + " de bônus!";
    proximoJogador();
    return;
  }

  if (c.tipo === "investir") {
    mensagem = "Deseja investir no mercado financeiro?";
    acaoPendente = "investir";
    return;
  }

  if (c.tipo === "evento") {
    eventoAleatorio();
    proximoJogador();
    return;
  }

  if (c.tipo === "descanso") {
    mensagem = "Dia tranquilo! Nenhuma movimentação financeira.";
    proximoJogador();
    return;
  }
}

