// ===============================
// AÇÕES DE COMPRA E INVESTIMENTO
// ===============================

function desenharAcao() {
  fill(20, 30, 48);
  rect(570, 520, 410, 215, 12);

  fill(255);
  textSize(15);
  text(mensagem, 775, 550, 380, 45);

  if (acaoPendente === "empresa") {
    let c = casas[jogadores[jogadorAtual].posicao];

    fill(255);
    textSize(13);
    text("Preço: R$ " + c.preco +
      " | Aluguel: R$ " + c.aluguel,
      775, 590);

    criarBotao("COMPRAR",
      590, 620, 175, 55, comprarEmpresa);

    criarBotao("PASSAR",
      780, 620, 175, 55, () => {
        acaoPendente = null;
        proximoJogador();
      });
  }

  if (acaoPendente === "investir") {
    fill(255);
    textSize(13);
    text("Investimento de R$ 1.000 com retorno de R$ 1.500 no patrimônio.",
      775, 595, 380, 35);

    criarBotao("INVESTIR",
      590, 630, 175, 50, investir);

    criarBotao("PASSAR",
      780, 630, 175, 50, () => {
        acaoPendente = null;
        proximoJogador();
      });
  }
}

function comprarEmpresa() {
  let j = jogadores[jogadorAtual];
  let c = casas[j.posicao];

  if (j.dinheiro >= c.preco) {
    j.dinheiro -= c.preco;
    c.dono = jogadorAtual;
    mensagem = j.nome + " comprou " + c.nome + "!";
  } else {
    mensagem = "Dinheiro insuficiente para comprar esta empresa!";
  }

  acaoPendente = null;
  proximoJogador();
}

function investir() {
  let j = jogadores[jogadorAtual];

  if (j.dinheiro >= 1000) {
    j.dinheiro -= 1000;
    j.investimentos += 1500;
    mensagem = "Investimento realizado! Patrimônio investido: R$ 1.500.";
  } else {
    mensagem = "Dinheiro insuficiente para investir!";
  }

  acaoPendente = null;
  proximoJogador();
}

// ===============================
// PATRIMÔNIO E VENCEDOR
// ===============================

function patrimonio(indice) {
  let j = jogadores[indice];
  let total = j.dinheiro + j.investimentos;

  for (let c of casas) {
    if (c.dono === indice) {
      total += c.preco;
    }
  }

  return total;
}

function proximoJogador() {
  historico.unshift(mensagem);

  if (historico.length > 4) {
    historico.pop();
  }

  if (jogadores.every(j => j.voltas >= rodadas)) {
    finalizarJogo();
    return;
  }

  let tentativas = 0;

  do {
    jogadorAtual = (jogadorAtual + 1) % jogadores.length;
    tentativas++;
  } while (
    jogadores[jogadorAtual].voltas >= rodadas &&
    tentativas <= jogadores.length
  );
}

function finalizarJogo() {
  jogoFinalizado = true;
  tela = "final";
}

// ===============================
// TELA FINAL
// ===============================

function desenharFinal() {
  fill(255);
  textSize(38);
  text("🏆 FIM DO JOGO!", width / 2, 85);

  let ranking = jogadores.slice().sort(
    (a, b) => patrimonio(jogadores.indexOf(b)) -
              patrimonio(jogadores.indexOf(a))
  );

  let vencedor = ranking[0];

  fill(...vencedor.cor);
  textSize(27);
  text("CAMPEÃO: " + vencedor.nome.toUpperCase(),
       width / 2, 155);

  fill(100, 220, 160);
  textSize(22);
  text("Patrimônio: R$ " +
    patrimonio(jogadores.indexOf(vencedor)).toLocaleString("pt-BR"),
    width / 2, 205);

  fill(255);
  textSize(20);
  text("CLASSIFICAÇÃO FINAL", width / 2, 280);

  for (let i = 0; i < ranking.length; i++) {
    let j = ranking[i];
    let original = jogadores.indexOf(j);

    fill(40, 55, 78);
    rect(220, 315 + i * 55, 560, 45, 10);

    fill(...j.cor);
    circle(250, 337 + i * 55, 20);

    fill(255);
    textSize(16);
    textAlign(LEFT, CENTER);
    text((i + 1) + "º - " + j.nome, 280, 337 + i * 55);

    textAlign(RIGHT, CENTER);
    text("R$ " + patrimonio(original).toLocaleString("pt-BR"),
         755, 337 + i * 55);

    textAlign(CENTER, CENTER);
  }

  criarBotao("JOGAR NOVAMENTE",
    350, 680, 300, 60, () => {
      tela = "inicio";
      criarTabuleiro();
    });
}

// ===============================
// BOTÕES
// ===============================

function criarBotao(rotulo, x, y, w, h, acao, selecionado = false) {
  let ativo =
    mouseX >= x && mouseX <= x + w &&
    mouseY >= y && mouseY <= y + h;

  if (selecionado) {
    fill(60, 180, 125);
  } else if (ativo) {
    fill(75, 150, 180);
  } else {
    fill(48, 105, 125);
  }

  noStroke();
  rect(x, y, w, h, 10);

  fill(255);
  textSize(16);
  text(rotulo, x + w / 2, y + h / 2);

  botoes.push({x, y, w, h, acao});
}

function mousePressed() {
  for (let b of botoes) {
    if (
      mouseX >= b.x && mouseX <= b.x + b.w &&
      mouseY >= b.y && mouseY <= b.y + b.h
    ) {
      b.acao();
      return false;
    }
  }
}

function touchStarted() {
  mousePressed();
  return false;
}
