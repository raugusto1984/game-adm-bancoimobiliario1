    {tipo:"descanso", nome:"PAUSA"}
  ];

  for (let c of casas) {
    c.dono = -1;
  }
}

function iniciarJogo() {
  jogadores = [];

  for (let i = 0; i < quantidadeJogadores; i++) {
    jogadores.push({
      nome: "Jogador " + (i + 1),
      cor: cores[i],
      dinheiro: 10000,
      posicao: 0,
      voltas: 0,
      investimentos: 0,
      ativo: true
    });
  }

  jogadorAtual = 0;
  dado = 1;
  acaoPendente = null;
  historico = [];
  jogoFinalizado = false;
  mensagem = "O jogo começou! Boa sorte!";
  tela = "jogo";
}

function draw() {
  background(22, 31, 48);
  botoes = [];

  if (tela === "inicio") {
    desenharInicio();
  } else if (tela === "jogo") {
    desenharJogo();
  } else if (tela === "final") {
    desenharFinal();
  }
}

// ===============================
// TELA INICIAL
// ===============================

